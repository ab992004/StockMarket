@model Orders

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Stock Orders</title>

    <link href="@("http://" + Context.Request.Host.ToString() + "/Stylesheet.css")" rel="stylesheet" />

    <style>
            body {
                font-family: Arial, sans-serif;
                margin: 25px;
            }

            h1 {
                text-align: center;
                margin-bottom: 25px;
            }

            h2 {
                margin-top: 25px;
                margin-bottom: 10px;
            }

            table {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 25px;
            }

            th, td {
                border: 1px solid #ccc;
                padding: 8px;
                text-align: left;
                font-size: 12px;
            }

            th {
                background-color: #eee;
            }

            .no-orders {
                margin-bottom: 20px;
            }
    </style>
</head>
<body>

    <h1>Stock Orders</h1>

    <h2>Buy Orders</h2>

    @if (Model.BuyOrders.Count > 0)
    {
        <table>
            <thead>
                <tr>
                    <th>Stock Name</th>
                    <th>Symbol</th>
                    <th>Quantity</th>
                    <th>Price</th>
                    <th>Trade Amount</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (BuyOrderResponse order in Model.BuyOrders)
                {
                    <tr>
                        <td>@order.StockName</td>
                        <td>@order.StockSymbol</td>
                        <td>@order.Quantity</td>
                        <td>$@order.Price.ToString("N")</td>
                        <td>$@order.TradeAmount.ToString("N")</td>
                        <td>@order.DateAndTimeOfOrder.ToString("dd MMM yyyy hh:mm:ss tt")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="no-orders">No buy orders.</p>
    }

    <h2>Sell Orders</h2>

    @if (Model.SellOrders.Count > 0)
    {
        <table>
            <thead>
                <tr>
                    <th>Stock Name</th>
                    <th>Symbol</th>
                    <th>Quantity</th>
                    <th>Price</th>
                    <th>Trade Amount</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (SellOrderResponse order in Model.SellOrders)
                {
                    <tr>
                        <td>@order.StockName</td>
                        <td>@order.StockSymbol</td>
                        <td>@order.Quantity</td>
                        <td>$@order.Price.ToString("N")</td>
                        <td>$@order.TradeAmount.ToString("N")</td>
                        <td>@order.DateAndTimeOfOrder.ToString("dd MMM yyyy hh:mm:ss tt")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="no-orders">No sell orders.</p>
    }

</body>
</html>